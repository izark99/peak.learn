# --- Supabase -------------------------------------------------------------
# The URL and publishable key are safe to expose in the browser bundle: they
# only grant what Row Level Security allows. Every table in this project has
# RLS enabled, so these are the real values for the peak.learn project.
NEXT_PUBLIC_SUPABASE_URL=https://fqcskypwfhdltwulfyci.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XcarcptJ0sMAyy-OzWwwig_JbGjUehg

# Server-only. Bypasses RLS entirely — never expose this to the client.
# Find it under Project Settings > API in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ------------------------------------------------------------
# Powers vocabulary extraction, photo OCR, grammar exercises, and the speaking
# partner. Leave this blank and the app falls back to a deterministic mock
# generator so every screen still works offline — see src/lib/ai/mock.ts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
